<?xml version="1.0" encoding="utf-8"?>
<!--
    O host não é uma linha numa lista: é um lugar, e ele está aceso ou não.
    Quem lê o estado é a luz atrás do ícone, não um rótulo — e como o que muda é
    intensidade e não matiz, a hierarquia continua legível para quem não distingue
    o azul. O rótulo de texto fica como reforço, nunca como única fonte.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="@dimen/vidro_space_2">

    <RelativeLayout
        android:layout_width="152dp"
        android:layout_height="184dp"
        android:background="@drawable/vidro_card_bg"
        android:padding="@dimen/vidro_space_3">

        <!-- A luz. Fica atrás de tudo; a alpha dela é definida pelo estado no adapter. -->
        <ImageView
            android:id="@+id/grid_halo"
            android:layout_width="match_parent"
            android:layout_height="118dp"
            android:layout_alignParentTop="true"
            android:layout_marginTop="-8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/vidro_halo_awake" />

        <RelativeLayout
            android:id="@+id/grid_image_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/vidro_space_3">

            <ImageView
                android:id="@+id/grid_image"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_centerHorizontal="true" />

            <ImageView
                android:id="@+id/grid_overlay"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="21dp" />

            <ProgressBar
                android:id="@+id/grid_spinner"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="21dp"
                android:indeterminate="true" />
        </RelativeLayout>

        <TextView
            android:id="@+id/grid_text"
            style="@style/VidroText.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/grid_image_layout"
            android:layout_marginTop="@dimen/vidro_space_3"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2" />
    </RelativeLayout>
</FrameLayout>
