<?xml version="1.0" encoding="utf-8"?>
<!--
    Grade do catálogo.

    numColumns FIXO em 2, não auto_fit. Num aparelho real o auto_fit calculou UMA coluna e
    ainda a encostou na direita — quatro capas empilhadas contra a borda, com metade da
    tela vazia. O protótipo especifica duas colunas; deixar a contagem por conta do
    cálculo de largura entregou algo que não é nem duas nem uma centrada.

    stretchMode columnWidth: as duas colunas dividem a largura disponível por igual, então
    a capa acompanha a tela em vez de ficar presa a uma medida absoluta.

    G1: focusableInTouchMode sobrevive aqui, no CONTAINER, não nos itens (nem
    app_grid_item nem pc_grid_item declaram focusable) — é o que deixa o GridView
    pronto para receber foco por D-pad assim que a tela abre, sem exigir um toque antes
    para sair do modo toque. Não é a causa do "toque duplo": quem despacha o clique de
    um item de GridView é o próprio AbsListView (performItemClick dentro do seu
    onTouchEvent), que nunca passa pelo requestFocus() de View.onTouchEvent — testado no
    s22ub tocando o card de PC (mesmo container) e o clique ativou no primeiro toque.
    O bug real (console_ajustes_basico_conteudo, console_capa_carousel_item) era
    focusableInTouchMode num item CLICÁVEL comum, não neste container de GridView.
-->

<GridView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragmentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:horizontalSpacing="0dp"
    android:numColumns="2"
    android:paddingLeft="@dimen/vidro_inset_card"
    android:paddingRight="@dimen/vidro_inset_card"
    android:paddingBottom="@dimen/vidro_thumb_reach"
    android:scrollbars="none"
    android:stretchMode="columnWidth"
    android:verticalSpacing="0dp" />
