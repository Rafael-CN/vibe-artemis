<!--
    Computadores (celular) — Plano B / F3, B-CONSOLE.md. Referência:
    B_Celular_Computadores.png / Celular_Computadores.dc.html.

        "Computadores" (título) → lista de cards altos (pc_grid_item/PcGridAdapter,
        AdapterFragment de sempre) → "Adicionar PC" tracejado, fixo no rodapé →
        Cenas · Ajustes, discreto, porque nem um nem outro têm tela dedicada nesta
        fatia (F4 e a home de cenas são fora de escopo aqui).

    settingsButton/profilesButton continuam existindo porque PcView#initializeViews
    os acessa sem checar nulo — "esconder pode, apagar não" também vale para uma
    entrada que o código já depende de existir.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/console_fundo"
    tools:context=".PcView"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/consoleComputadoresTitulo"
        style="@style/ConsoleText.Titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingLeft="@dimen/console_espaco_5"
        android:paddingTop="@dimen/console_espaco_5"
        android:paddingRight="@dimen/console_espaco_5"
        android:paddingBottom="@dimen/console_espaco_3"
        android:text="@string/console_computadores_titulo" />

    <!-- ================= rodapé: Adicionar PC + Cenas/Ajustes discretos ================= -->

    <LinearLayout
        android:id="@+id/vidroFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingLeft="@dimen/console_espaco_5"
        android:paddingRight="@dimen/console_espaco_5"
        android:paddingBottom="@dimen/console_espaco_4">

        <FrameLayout
            android:id="@+id/vidroAddPlace"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="@dimen/console_espaco_3"
            android:background="@drawable/console_borda_tracejada"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/console_foco">

            <TextView
                style="@style/ConsoleText.Rotulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawablePadding="@dimen/console_espaco_2"
                android:gravity="center_vertical"
                android:text="@string/console_add_pc"
                app:drawableStartCompat="@drawable/console_ic_add" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/profilesButton"
                style="@style/ConsoleText.Rotulo2"
                android:layout_width="0dp"
                android:layout_height="@dimen/vidro_touch_target"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/profile_manager_choose_profile"
                android:gravity="center"
                android:text="@string/vidro_scenes" />

            <TextView
                android:id="@+id/settingsButton"
                style="@style/ConsoleText.Rotulo2"
                android:layout_width="0dp"
                android:layout_height="@dimen/vidro_touch_target"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/vidro_settings" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================= lista de PCs ================= -->

    <RelativeLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/vidroFooter"
        android:layout_below="@id/consoleComputadoresTitulo">

        <!-- Estado vazio: nenhum PC encontrado ainda. -->
        <LinearLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="@dimen/console_espaco_6"
            android:paddingRight="@dimen/console_espaco_6">

            <FrameLayout
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:background="@drawable/vidro_searching_ring">

                <ProgressBar
                    android:id="@+id/pcs_loading"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/console_acento" />
            </FrameLayout>

            <TextView
                style="@style/ConsoleText.Card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/console_espaco_5"
                android:gravity="center"
                android:text="@string/vidro_searching_title" />

            <TextView
                style="@style/ConsoleText.Rotulo2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/console_espaco_2"
                android:gravity="center"
                android:maxWidth="300dp"
                android:text="@string/vidro_searching_sub" />
        </LinearLayout>

    </RelativeLayout>

    <include layout="@layout/vidro_pairing" />

</RelativeLayout>
