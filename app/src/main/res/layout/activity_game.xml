    <!--
        Em sessão o vidro é FOSCO, nunca embaçado. O vídeo desenha num SurfaceView,
        numa camada de hardware separada da árvore de views, então RenderEffect só
        borraria o que está na mesma camada — ou seja, nada. Alpha 0,82 entrega a
        mesma leitura e devolve a GPU inteira para o decodificador.

        Aviso mora no topo porque aviso não se toca: ação vive nos 96dp de baixo.
    -->
    <TextView
        android:id="@+id/notificationOverlay"
        style="@style/VidroText.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:layout_marginTop="@dimen/vidro_space_3"
        android:layout_marginRight="@dimen/vidro_space_3"
        android:layout_marginEnd="@dimen/vidro_space_3"
        android:background="@drawable/vidro_glass_pill"
        android:gravity="right"
        android:paddingLeft="@dimen/vidro_space_4"
        android:paddingTop="@dimen/vidro_space_2"
        android:paddingRight="@dimen/vidro_space_4"
        android:paddingBottom="@dimen/vidro_space_2"
        android:preferKeepClear="true"
        android:textColor="@color/vidro_text"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/performanceOverlay"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!--
            Números em tabular. Latência, FPS e perda mudam a cada quadro; sem tnum a
            linha inteira dança e vira impossível de ler durante o jogo.
        -->
        <TextView
            android:id="@+id/performanceOverlayBig"
            style="@style/VidroText.Numeric"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_marginLeft="@dimen/vidro_space_3"
            android:layout_marginStart="@dimen/vidro_space_3"
            android:layout_marginTop="@dimen/vidro_space_3"
            android:background="@drawable/vidro_glass_session"
            android:gravity="left"
            android:lineSpacingMultiplier="1.45"
            android:paddingLeft="@dimen/vidro_space_3"
            android:paddingTop="@dimen/vidro_space_2"
            android:paddingRight="@dimen/vidro_space_3"
            android:paddingBottom="@dimen/vidro_space_2"
            android:preferKeepClear="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/performanceOverlayLite"
            style="@style/VidroText.Numeric"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/vidro_space_1"
            android:background="@drawable/vidro_glass_pill"
            android:paddingLeft="@dimen/vidro_space_3"
            android:paddingTop="3dp"
            android:paddingRight="@dimen/vidro_space_3"
            android:paddingBottom="3dp"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="18ms · 7ms · 0% · 120fps" />

    </LinearLayout>

    <!--
        A ilha de controle e a pílula em que ela vira. Ficam por último no merge
        para desenhar por cima do vídeo, e nos 96 dp de baixo, onde o polegar chega
        sem soltar o aparelho.
    -->

    <!--
        Folha de ajustes, aviso de queda e a tela de conectar. Vêm DEPOIS da ilha no
        merge porque precisam cobri-la: enquanto a conexão não voltou, mexer nos
        controles não leva a lugar nenhum.
    -->
    <!--
        A CASCA, por cima de tudo. É o que faz sair da sessão deixar de matá-la.

        Ela nasce GONE e é inflada com o layout inteiro do arranque frio — o mesmo
        `activity_pc_view.xml`, que virou <merge> justamente para caber aqui. Uma casca só,
        dois hospedeiros: ver CascaDoApp.

        O FrameLayout de embrulho existe para poder esconder e mostrar o conjunto de uma vez,
        e para comer o toque enquanto está de pé — sem ele, tocar na lista atravessaria para o
        jogo que continua rodando atrás. Ele custa um nível de árvore, e custa ZERO enquanto
        está GONE, que é onde ele passa a esmagadora maioria do tempo.
    -->
    <FrameLayout
        android:id="@+id/vidroCascaCamada"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vidro_void"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <include layout="@layout/activity_pc_view" />
    </FrameLayout>

    <include layout="@layout/vidro_compose_bar" />
    <include layout="@layout/vidro_lost" />
    <include layout="@layout/vidro_connecting" />

    <!--
        Aqui moravam os dois botões flutuantes — menu e zoom. Saíram, e o que sobra é a
        ilha com o punho: mesmo menu, mesmo zoom, mesmo arrastar, só que com âncora e alvo
        de toque de verdade. Os dois discos tinham 36 dp (abaixo do alvo mínimo) e
        elevation 9999dp, que os punha por cima até da ilha.
    -->

</merge>