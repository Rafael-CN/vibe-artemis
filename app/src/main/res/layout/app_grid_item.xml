<?xml version="1.0" encoding="utf-8"?>
<!--
    Card de app do catálogo. Capa de 132 dp com raio 20, e o nome POR FORA, embaixo —
    não sobreposto. Sobrepor obrigaria um véu sobre toda capa para garantir contraste,
    e o véu apaga justamente a arte que faz a grade valer a pena.

    Remote Display e Remote Control usam este mesmo card: o que os diferencia é a
    pílula ("tela", "entrada"), nunca um botão especial. O host publica, o app lista.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="5dp"
    android:paddingTop="5dp"
    android:paddingRight="5dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="132dp">

            <ImageView
                android:id="@+id/grid_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/vidro_placeholder"
                android:cropToPadding="false"
                android:scaleType="centerCrop" />

            <!-- Camada de estado; o adapter pinta o fundo dela quando o app está aberto. -->
            <RelativeLayout
                android:id="@+id/grid_mask"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/grid_overlay"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_centerInParent="true" />
            </RelativeLayout>


            <TextView
                android:id="@+id/grid_pill"
                style="@style/VidroText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="11dp"
                android:layout_marginEnd="11dp"
                android:layout_marginRight="11dp"
                android:background="@drawable/vidro_pill"
                android:fontFamily="@font/manrope_bold"
                android:paddingLeft="9dp"
                android:paddingTop="4dp"
                android:paddingRight="9dp"
                android:paddingBottom="4dp"
                android:textSize="10sp"
                android:visibility="gone"
                tools:text="aberto"
                tools:visibility="visible" />

            <!-- Borda de acento quando o app está em execução; senão, fio de 1px. -->
            <View
                android:id="@+id/grid_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/vidro_poster_frame"
                android:duplicateParentState="true" />

            <ProgressBar
                android:id="@+id/grid_spinner"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_centerInParent="true"
                android:indeterminate="true"
                android:indeterminateTint="@color/vidro_accent_text"
                android:visibility="gone" />
        </RelativeLayout>

        <TextView
            android:id="@+id/grid_text"
            style="@style/VidroText.Item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginLeft="2dp"
            android:layout_marginStart="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="15sp"
            tools:text="Desktop" />
    </LinearLayout>
</FrameLayout>
