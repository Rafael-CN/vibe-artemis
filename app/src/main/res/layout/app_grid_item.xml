<?xml version="1.0" encoding="utf-8"?>
<!--
    Card de app do catálogo. Capa de 132 dp com raio 20, e o nome POR FORA, embaixo —
    quando existe. O Vibeshine assa o nome dentro da própria box art, e nesse caso o
    carregador esconde o rótulo em vez de repetir a palavra duas vezes.

    Remote Monitor e Remote Input usam este mesmo card: o que os diferencia é a pílula,
    nunca um botão especial. O host publica, o app lista.

    O container é FrameLayout e não RelativeLayout de propósito. Em RelativeLayout a
    pílula com wrap_content saía medida mais estreita que o próprio texto — lia-se "nput"
    em vez de "input", com a palavra transbordando o fundo. FrameLayout mede filho por
    gravidade sem essa ambiguidade.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/vidro_space_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="132dp">

            <ImageView
                android:id="@+id/grid_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/vidro_placeholder"
                android:cropToPadding="false"
                android:scaleType="centerCrop" />

            <!--
                Camada de estado; o adapter pinta o fundo dela quando o app está aberto.

                grid_overlay (ícone de play do app "em execução") vai no canto
                inferior-direito, não centralizado (F6, pendência apontada na
                verificação da F3): quando o host não publica box art, o nome do app
                é desenhado dentro da própria capa gerada pelo carregador — centrado,
                igual às outras capas sem nome embaixo — e o ícone de 46dp cobria o
                meio dele. O canto fica livre em qualquer capa (real ou gerada).
            -->
            <RelativeLayout
                android:id="@+id/grid_mask"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/grid_overlay"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_margin="@dimen/vidro_space_3" />
            </RelativeLayout>

            <TextView
                android:id="@+id/grid_pill"
                style="@style/VidroText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/vidro_space_3"
                android:background="@drawable/vidro_pill"
                android:fontFamily="@font/manrope_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingLeft="@dimen/vidro_space_3"
                android:paddingTop="@dimen/vidro_space_1"
                android:paddingRight="@dimen/vidro_space_3"
                android:paddingBottom="@dimen/vidro_space_1"
                android:singleLine="true"
                android:textSize="10sp"
                android:visibility="gone"
                tools:text="aberto"
                tools:visibility="visible" />

            <!-- Borda de acento quando o app está em execução; senão, fio de 1px. -->
            <View
                android:id="@+id/grid_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/vidro_poster_frame"
                android:duplicateParentState="true" />

            <ProgressBar
                android:id="@+id/grid_spinner"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/console_acento"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/grid_text"
            style="@style/VidroText.Item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vidro_space_2"
            android:layout_marginLeft="2dp"
            android:layout_marginStart="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="15sp"
            tools:text="Desktop" />
    </LinearLayout>
</FrameLayout>
