<?xml version="1.0" encoding="utf-8"?>
<!--
    "Não apareceu — inserir endereço". É a saída alternativa do pareamento, e o protótipo
    a trata como tela própria: título, uma explicação que diz por que a porta existe, o
    campo, e a volta para a busca.

    Era a última tela com a cara do Moonlight original — fundo #1A1A1A, textAppearanceLarge
    e um Button de sistema no canto.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vidro_void"
    tools:context=".preferences.AddComputerManually">

    <com.limelight.ui.VidroLightView
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_alignParentTop="true"
        app:vidro_intensity="0.20" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vidro_space_5"
        android:paddingTop="@dimen/vidro_space_5"
        android:paddingRight="@dimen/vidro_space_5">

        <TextView
            style="@style/VidroText.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vidro_new_place" />

        <TextView
            android:id="@+id/manuallyAddPcText"
            style="@style/VidroText.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vidro_space_2"
            android:preferKeepClear="true"
            android:text="@string/vidro_pc_address" />

        <TextView
            style="@style/VidroText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vidro_space_2"
            android:text="@string/vidro_address_help" />

        <EditText
            android:id="@+id/hostTextView"
            style="@style/VidroText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/vidro_space_5"
            android:background="@drawable/vidro_field"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:hint="@string/ip_hint"
            android:inputType="textNoSuggestions"
            android:paddingLeft="@dimen/vidro_space_4"
            android:paddingRight="@dimen/vidro_space_4"
            android:preferKeepClear="true"
            android:singleLine="true"
            android:textColor="@color/vidro_text"
            android:textColorHint="@color/vidro_text_3"
            android:textCursorDrawable="@null"
            android:textSize="15sp">

            <requestFocus />
        </EditText>

        <TextView
            android:id="@+id/addPcButton"
            style="@style/VidroButton.Accent"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="@dimen/vidro_space_4"
            android:gravity="center"
            android:preferKeepClear="true"
            android:text="@string/vidro_connect" />
    </LinearLayout>

</RelativeLayout>
