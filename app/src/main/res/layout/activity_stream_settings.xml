<?xml version="1.0" encoding="utf-8"?>
<!--
    Ajustes. O corpo é um PreferenceScreen montado pelo androidx, mas o topo é nosso: a
    luz e o título grande, para a tela pertencer ao mesmo app que a home.

    O id `stream_settings` continua sendo o container do fragment — StreamSettings.java
    injeta nele — só que agora ele é um FrameLayout ABAIXO do título, e não mais a raiz.
    Como raiz, o fragment cobria o cabeçalho inteiro.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/console_fundo"
    tools:context=".preferences.StreamSettings"
    android:fitsSystemWindows="true">

    <com.limelight.ui.VidroLightView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_alignParentTop="true"
        app:vidro_intensity="0.20"
        app:vidro_center_y="0" />

    <TextView
        android:id="@+id/vidroSettingsTitle"
        style="@style/VidroText.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingLeft="@dimen/vidro_space_5"
        android:paddingTop="@dimen/vidro_space_5"
        android:paddingRight="@dimen/vidro_space_5"
        android:paddingBottom="@dimen/vidro_space_3"
        android:text="@string/vidro_settings" />

    <FrameLayout
        android:id="@+id/stream_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/vidroSettingsTitle" />

</RelativeLayout>
