<?xml version="1.0" encoding="utf-8"?>
<!--
    Barra de composição — o que faltava para digitar numa tela que não é sua.

    Digitando direto no stream, cada tecla viaja para o PC e o que você vê é o vídeo
    voltando: se a rede oscila, você digita às cegas, e um erro só aparece depois de já
    ter sido enviado. Aqui o texto é montado LOCALMENTE, com o cursor e a seleção do
    próprio Android, e só viaja quando você manda.

    Fica colada no teclado porque é isso que o olho espera: a linha que você está
    escrevendo tem que estar onde a mão está.

    Fosca, como tudo que fica por cima do vídeo.

    Os espaços da fileira são todos iguais: 12 dp de cada margem externa e 12 dp entre uma
    peça e a seguinte. Com 16 dp fora e 8 dp dentro o vão interno virava metade do externo
    e o botão lia como parte do campo, não como peça própria.

    O "Fechar" existe porque a única saída da barra era o chevron do teclado — controle do
    Android, não do app: quem abrisse a barra sem querer, ou desistisse de mandar o texto,
    dependia de um botão que não é nosso e que em gestos nem sempre está desenhado. Fica à
    ESQUERDA do campo, longe do polegar que manda: sair não disputa lugar com enviar.

    O "Enviar" NASCE desabilitado. Ele era pixel a pixel o mesmo com o campo vazio e com
    texto — mesmo azul, mesma opacidade —, então prometia uma ação que não tinha o que
    executar: tocar nele com o campo em branco não fazia nada e nada dizia por quê. Quem
    liga e desliga é Game.setupComposeBar, olhando o texto sem espaços em volta.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/vidroComposeBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/vidro_compose_bg"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vidro_space_3"
        android:paddingTop="@dimen/vidro_space_3"
        android:paddingRight="@dimen/vidro_space_3"
        android:paddingBottom="@dimen/vidro_space_3"
        android:visibility="gone"
        tools:visibility="visible">

        <!--
            A PALETA DE COMANDOS, e ela mora DENTRO da barra de proposito.

            Como irma, ela nao seria carregada pelo deslocamento de IME nem pelo recuo da
            area segura, que sao aplicados a `vidroComposeBar` por id. Dentro dela, a lista
            sobe junto com o teclado, encosta na mesma borda e reaproveita o mesmo fundo
            fosco: uma superficie so, que e a ideia inteira desta tela.

            E nasce GONE. Com a capa acoplada o repouso continua sendo um campo de texto e
            mais nada; a lista so existe depois que a seta desce.
        -->
        <ScrollView
            android:id="@+id/vidroPaletaRolagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vidro_space_2"
            android:maxHeight="@dimen/vidro_paleta_altura_max"
            android:scrollbars="none"
            android:visibility="gone"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!--
                    UM realce, e ele viaja. Ele fica ATRAS da lista e e movido por
                    translacao, nunca por troca de fundo linha a linha. A diferenca e a de
                    acompanhar uma coisa que se move contra ver duas coisas piscando.
                -->
                <View
                    android:id="@+id/vidroPaletaRealce"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/vidro_touch_target"
                    android:background="@drawable/vidro_chip_on"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/vidroPaletaLista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </FrameLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/vidroComposeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <TextView
            android:id="@+id/vidroComposeClose"
            style="@style/VidroText"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vidro_touch_target"
            android:layout_marginEnd="@dimen/vidro_space_3"
            android:layout_marginRight="@dimen/vidro_space_3"
            android:background="@drawable/vidro_button_ghost_bg"
            android:fontFamily="@font/manrope_semibold"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:paddingLeft="@dimen/vidro_space_4"
            android:paddingRight="@dimen/vidro_space_4"
            android:text="@string/vidro_close"
            android:textColor="@color/vidro_text_2"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/vidroComposeInput"
            style="@style/VidroText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/vidro_field_session"
            android:hint="@string/vidro_compose_hint"
            android:imeOptions="actionSend|flagNoExtractUi"
            android:inputType="textMultiLine|textNoSuggestions"
            android:maxLines="4"
            android:minHeight="@dimen/vidro_touch_target"
            android:paddingLeft="@dimen/vidro_space_4"
            android:paddingTop="@dimen/vidro_space_3"
            android:paddingRight="@dimen/vidro_space_4"
            android:paddingBottom="@dimen/vidro_space_3"
            android:textColor="@color/vidro_text"
            android:textColorHint="@color/vidro_text_3"
            android:textCursorDrawable="@drawable/vidro_caret"
            android:textSize="15sp"
            tools:text="git commit -m" />

        <TextView
            android:id="@+id/vidroComposeSend"
            style="@style/VidroText"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vidro_touch_target"
            android:layout_marginStart="@dimen/vidro_space_3"
            android:layout_marginLeft="@dimen/vidro_space_3"
            android:background="@drawable/vidro_button_accent_bg"
            android:enabled="false"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:paddingLeft="@dimen/vidro_space_5"
            android:paddingRight="@dimen/vidro_space_5"
            android:text="@string/vidro_compose_send"
            android:textColor="@drawable/vidro_button_accent_text"
            android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

</merge>
