<?xml version="1.0" encoding="utf-8"?>
<!--
    Barra de texto — a pele Console da barra de composição (B-CONSOLE.md §F2).
    Mecânica intacta: Game.java#openComposeBar/closeComposeBar/sendTextBlock e o
    ImeDisplayMode.RESIZE por padrão continuam exatamente como estavam; só o
    desenho muda de vidro_compose_bar.xml para este arquivo, com os tokens e a
    tipografia da NOTA.md.

    Digitar direto no stream é digitar às cegas: cada tecla viaja e o que volta é
    vídeo. Aqui o texto se monta LOCALMENTE e só atravessa quando a pessoa manda.

    G2, defeito 4 ("o digitar com input tá mto grande e n dá pra ver a tela"): os
    recuos e respiros usam console_barra_texto_pad_h/pad_v/gap em vez dos
    console_espaco_* compartilhados — no celular (values/dimens.xml) eles encolhem;
    no tablet (values-sw600dp) valem o mesmo que console_espaco_4/3/2 sempre
    valeram. A fileira de teclas especiais some atrás de um alternador
    (consoleBarraTextoTeclasToggle) que Game.java liga; começa recolhida no
    celular e sempre visível no tablet (console_barra_teclas_recolhida_por_padrao).
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/vidroComposeBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/console_barra_texto_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/console_barra_texto_pad_h"
        android:paddingEnd="@dimen/console_barra_texto_pad_h"
        android:paddingTop="@dimen/console_barra_texto_pad_v"
        android:paddingBottom="@dimen/console_barra_texto_pad_v"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Cabeçalho: "BARRA DE TEXTO" e, só se o app já tiver os números do
             overlay de desempenho ligado, a mesma leitura em mono à direita —
             nunca um valor inventado (B-CONSOLE.md §F2). -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/ConsoleText.Legenda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/console_barra_texto_titulo" />

            <TextView
                android:id="@+id/consoleBarraTextoMetrica"
                style="@style/ConsoleText.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:textColor="@color/console_texto_2"
                android:visibility="gone"
                tools:text="18 ms · 35 Mbps"
                tools:visibility="visible" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/console_barra_texto_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/vidroComposeInput"
                style="@style/ConsoleText.Rotulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/console_campo_bg"
                android:hint="@string/vidro_compose_hint"
                android:imeOptions="actionSend|flagNoExtractUi"
                android:inputType="textMultiLine|textNoSuggestions"
                android:maxLines="4"
                android:minHeight="@dimen/console_botao"
                android:paddingStart="@dimen/console_espaco_3"
                android:paddingTop="@dimen/console_espaco_2"
                android:paddingEnd="@dimen/console_espaco_3"
                android:paddingBottom="@dimen/console_espaco_2"
                android:textColorHint="@color/console_texto_2"
                tools:text="ipconfig /all" />

            <TextView
                android:id="@+id/vidroComposeSend"
                style="@style/ConsoleBotao.Primario"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/console_botao"
                android:layout_marginStart="@dimen/console_espaco_2"
                android:drawablePadding="@dimen/console_espaco_1"
                android:drawableStart="@drawable/ic_console_enviar"
                android:text="@string/vidro_compose_send" />
        </LinearLayout>

        <!-- Alternador: só existe para dar pra recolher a fileira abaixo no celular
             (console_barra_teclas_recolhida_por_padrao). No tablet Game.java o
             deixa GONE e a fileira fica sempre visível, como sempre esteve.

             G2, defeito 4 (verificação): minHeight=vidro_touch_target (48dp) — sem
             isso o alvo real media ~25dp (texto + 2×console_espaco_1), abaixo do
             mínimo mesmo depois de corrigida a posição acima do teclado
             (updateComposeBar). gravity=center_vertical já centra texto+chevron
             dentro da altura maior. -->
        <LinearLayout
            android:id="@+id/consoleBarraTextoTeclasToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/console_barra_texto_gap"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/vidro_touch_target"
            android:orientation="horizontal"
            android:paddingTop="@dimen/console_espaco_1"
            android:paddingBottom="@dimen/console_espaco_1">

            <TextView
                style="@style/ConsoleText.Legenda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/console_guia_teclas_especiais" />

            <ImageView
                android:id="@+id/consoleBarraTextoTeclasToggleChevron"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="@dimen/console_espaco_1"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_console_chevron_down" />
        </LinearLayout>

        <!-- HorizontalScrollView, não LinearLayout: cinco teclas (a mais larga,
             Ctrl+Alt+Del, sozinha já passa de 112dp) não cabem lado a lado na
             largura de um celular em retrato sem rolar — sem isso as últimas
             ficavam fora da tela e inalcançáveis (G2, defeito 4). -->
        <HorizontalScrollView
            android:id="@+id/consoleBarraTextoTeclasRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/console_barra_texto_gap"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include layout="@layout/console_teclas_fileira" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

</merge>
