<?xml version="1.0" encoding="utf-8"?>
<!--
    Folha de ajustes em sessão. Tela 05 do handoff.

    O handoff descreve "folha de baixo para cima" e o MAPA sugere BottomSheet; o protótipo
    faz painel lateral de 352 dp. Aqui o protótipo ganha, e por um motivo de plataforma: a
    sessão é 852×393 paisagem, e uma folha subindo do rodapé come justamente a dimensão
    curta — sobraria uma faixa. Na lateral ela cabe inteira sem encostar no vídeo útil.

    O stream NÃO desmonta e o aparelho não volta para retrato: isto é uma View por cima,
    não uma Activity nova.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:id="@+id/vidroSheetScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vidro_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">

        <ScrollView
            android:id="@+id/vidroSheet"
            android:layout_width="@dimen/vidro_sheet_width"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@drawable/vidro_sheet_bg"
            android:paddingLeft="18dp"
            android:paddingTop="15dp"
            android:paddingRight="18dp"
            android:paddingBottom="15dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/manrope_extrabold"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.03"
                        android:text="@string/vidro_sheet_title"
                        android:textColor="@color/vidro_text"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/vidroSheetClose"
                        style="@style/VidroText.Support"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/vidro_touch_target"
                        android:text="@string/vidro_close"
                        android:textColor="@color/vidro_accent_text" />
                </RelativeLayout>

                <TextView
                    style="@style/VidroText.Support"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/vidro_sheet_sub" />

                <!-- ===== taxa de bits ===== -->

                <TextView
                    style="@style/VidroText.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vidro_space_5"
                    android:text="@string/vidro_bitrate" />

                <!--
                    A taxa de bits é a única coisa desta folha que NÃO vale agora: ela
                    entra na StreamConfiguration ao conectar e não há como trocá-la com a
                    sessão de pé. Dizer isso custa uma linha; deixar a pessoa mexer e não
                    ver nada mudar custa a confiança na folha inteira.
                -->
                <TextView
                    style="@style/VidroText.Support"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/vidro_next_session"
                    android:textSize="11.5sp" />

                <LinearLayout
                    android:id="@+id/vidroBitrateGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vidro_space_2"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/vidroBitrate20"
                        style="@style/VidroChip"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="20 Mbps" />

                    <TextView
                        android:id="@+id/vidroBitrate40"
                        style="@style/VidroChip"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:text="40 Mbps" />

                    <TextView
                        android:id="@+id/vidroBitrate60"
                        style="@style/VidroChip"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:text="60 Mbps" />
                </LinearLayout>

                <!-- ===== ritmo de quadros ===== -->

                <TextView
                    style="@style/VidroText.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vidro_space_5"
                    android:text="@string/vidro_frame_pacing" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vidro_space_2"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/vidroPacingSmooth"
                        style="@style/VidroChip"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/vidro_pacing_smooth" />

                    <TextView
                        android:id="@+id/vidroPacingBalanced"
                        style="@style/VidroChip"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:text="@string/vidro_pacing_balanced" />

                    <TextView
                        android:id="@+id/vidroPacingLatency"
                        style="@style/VidroChip"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:text="@string/vidro_pacing_latency" />
                </LinearLayout>

                <!-- ===== modo do mouse ===== -->

                <TextView
                    style="@style/VidroText.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vidro_space_5"
                    android:text="@string/vidro_mouse_mode" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vidro_space_2"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/vidroMouseMultitouch"
                        style="@style/VidroChip"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/vidro_mouse_multitouch" />

                    <TextView
                        android:id="@+id/vidroMouseTrackpad"
                        style="@style/VidroChip"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:text="@string/vidro_mouse_trackpad" />
                </LinearLayout>

                <!-- ===== números na tela ===== -->

                <RelativeLayout
                    android:id="@+id/vidroNumbersRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vidro_space_5"
                    android:background="?android:attr/selectableItemBackground"
                    android:minHeight="52dp">

                    <Switch
                        android:id="@+id/vidroNumbersSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:clickable="false"
                        android:focusable="false"
                        android:thumbTint="@color/vidro_text"
                        android:trackTint="@color/vidro_accent_glow" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/vidro_space_3"
                        android:layout_marginRight="@dimen/vidro_space_3"
                        android:layout_toStartOf="@id/vidroNumbersSwitch"
                        android:layout_toLeftOf="@id/vidroNumbersSwitch"
                        android:orientation="vertical">

                        <TextView
                            style="@style/VidroText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/manrope_semibold"
                            android:letterSpacing="-0.015"
                            android:text="@string/vidro_numbers_on_screen"
                            android:textSize="14.5sp" />

                        <TextView
                            style="@style/VidroText.Support"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/vidro_numbers_sub"
                            android:textSize="12sp" />
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</merge>
