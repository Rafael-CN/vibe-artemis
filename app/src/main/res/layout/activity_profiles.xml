<?xml version="1.0" encoding="utf-8"?>
<!--
    Cenas, agora so a casca que hospeda o Compose.

    O que havia aqui - cabecalho, descricao, RecyclerView com GridLayoutManager, estado
    vazio e o botao do rodape - virou com.limelight.ui.compose.TelaCenas. Junto foram as
    variantes de tablet e o R.integer que contava colunas por pasta de recurso: a contagem
    agora sai da largura real, que e o que ela sempre quis dizer.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vidro_void">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/vidroCenasCompose"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
