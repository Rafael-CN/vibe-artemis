<?xml version="1.0" encoding="utf-8"?>
<!--
    Uma coluna. O protótipo lista lugares, não os dispõe em grade: uma linha por host,
    com o estado em palavra à direita. Grade de ladrilhos era a herança do Moonlight.

    G1: focusableInTouchMode fica no container por focar por D-pad assim que a tela
    abre; não é a causa do "toque duplo" (o clique de item de GridView passa pelo
    AbsListView, não pelo requestFocus() de View.onTouchEvent) — mesma explicação de
    app_grid_view.xml, testada tocando o card "RAFAEL" no s22ub: ativou no 1º toque.
-->
<GridView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragmentView"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:numColumns="1"
    android:clipToPadding="false"
    android:divider="@null"
    android:dividerHeight="0dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:listSelector="@android:color/transparent"
    android:nextFocusLeft="@id/settingsButton"
    android:paddingBottom="@dimen/vidro_space_4"
    android:scrollbars="none"
    android:stretchMode="columnWidth" />
