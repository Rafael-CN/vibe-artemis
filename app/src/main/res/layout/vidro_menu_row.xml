<?xml version="1.0" encoding="utf-8"?>
<!--
    Linha do menu da sessão. Substitui android.R.layout.simple_list_item_1, que trazia
    Roboto e o espaçamento do sistema para dentro de um app que não usa nenhum dos dois.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:fontFamily="@font/manrope_semibold"
    android:gravity="center_vertical"
    android:includeFontPadding="false"
    android:letterSpacing="-0.02"
    android:minHeight="@dimen/vidro_touch_target"
    android:paddingLeft="@dimen/vidro_space_5"
    android:paddingRight="@dimen/vidro_space_5"
    android:textColor="@color/vidro_text"
    android:textSize="16sp"
    tools:text="Enviar texto" />
