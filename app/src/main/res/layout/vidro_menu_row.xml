<?xml version="1.0" encoding="utf-8"?>
<!--
    Linha do menu da sessão. Substitui android.R.layout.simple_list_item_1, que trazia
    Roboto e o espaçamento do sistema para dentro de um app que não usa nenhum dos dois.

    A segunda linha existe por causa das duas saídas. "Sair da tela" deixa o jogo de pé no
    PC e "Encerrar sessão" fecha o que está aberto lá — os dois rótulos, sozinhos e
    empilhados um no outro, não diziam qual era qual, e quem lia escolhia no palpite. Ela
    some quando a ação não precisa dela, então o resto do menu continua de uma linha só e
    a lista não vira um bloco de texto.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/vidro_touch_target"
    android:orientation="vertical"
    android:paddingLeft="@dimen/vidro_space_5"
    android:paddingTop="@dimen/vidro_space_2"
    android:paddingRight="@dimen/vidro_space_5"
    android:paddingBottom="@dimen/vidro_space_2"
    android:stateListAnimator="@animator/vidro_press">

    <TextView
        android:id="@+id/menu_row_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_semibold"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:textColor="@color/vidro_text"
        android:textSize="16sp"
        tools:text="Sair da tela" />

    <TextView
        android:id="@+id/menu_row_hint"
        style="@style/VidroText.Support"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="a sessão continua aberta no PC"
        tools:visibility="visible" />
</LinearLayout>
