<?xml version="1.0" encoding="utf-8"?>
<!--
    Conteúdo da Ajustes básica (Plano B / F4, B-CONSOLE.md §F4). Referência:
    docs/design/console/fotos/B_Tablet_Ajustes.png e B_Celular_Ajustes.png.

    Incluído por layout/activity_stream_settings_basico.xml (celular, largura cheia) e
    layout-sw600dp/activity_stream_settings_basico.xml (tablet, coluna centrada de
    720dp) — o conteúdo é idêntico nos dois; o que muda é só a moldura em volta
    (ScrollView com padding cheio vs. coluna centrada), e a altura de linha
    (console_linha_ajuste) e o tamanho de ConsoleText.Rotulo, que já variam por
    qualificador sw600dp desde a F1.

    Cada linha é fixa (não um adapter): a tela básica tem uma lista finita e conhecida
    de controles, igual ao mockup — não há necessidade de RecyclerView aqui.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ================= cabeçalho ================= -->

    <LinearLayout
        android:id="@+id/consoleAjustesVoltar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/console_foco"
        android:clickable="true"
        android:contentDescription="@string/console_voltar_inicio_desc"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/vidro_touch_target"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/console_espaco_2"
        android:paddingRight="@dimen/console_espaco_3">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="@dimen/console_espaco_2"
            android:layout_marginRight="@dimen/console_espaco_2"
            android:importantForAccessibility="no"
            android:rotation="180"
            android:src="@drawable/console_ic_chevron"
            app:tint="@color/console_texto_2" />

        <TextView
            style="@style/ConsoleText.Rotulo2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/console_inicio_titulo" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/console_espaco_1">

        <TextView
            style="@style/ConsoleText.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/console_ajustes_titulo" />

        <TextView
            android:id="@+id/consoleAjustesPcAtual"
            style="@style/ConsoleText.Rotulo2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/console_espaco_4"
            android:layout_marginLeft="@dimen/console_espaco_4"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:visibility="gone"
            tools:text="ARTEMIS · 192.168.0.10"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- ================= cartão de ajustes básicos ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/console_espaco_5"
        android:background="@drawable/console_card_bg"
        android:orientation="vertical">

        <!-- Resolução -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/console_linha_ajuste"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/console_espaco_4"
            android:paddingRight="@dimen/console_espaco_4">

            <TextView
                style="@style/ConsoleText.Rotulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/console_ajuste_resolucao" />

            <TextView
                android:id="@+id/consoleResolucaoValorMono"
                style="@style/ConsoleText.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="2732x2048" />

            <LinearLayout
                android:id="@+id/consoleResolucaoSegmentos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/consoleSeg1080p"
                    style="@style/ConsoleSegmento"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="56dp"
                    android:background="@drawable/console_segmento_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingLeft="@dimen/console_espaco_4"
                    android:paddingRight="@dimen/console_espaco_4"
                    android:text="@string/resolution_1080p"
                    android:textColor="@color/console_segmento_texto" />

                <TextView
                    android:id="@+id/consoleSeg1440p"
                    style="@style/ConsoleSegmento"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="@dimen/console_espaco_2"
                    android:layout_marginLeft="@dimen/console_espaco_2"
                    android:minWidth="56dp"
                    android:background="@drawable/console_segmento_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingLeft="@dimen/console_espaco_4"
                    android:paddingRight="@dimen/console_espaco_4"
                    android:text="@string/resolution_1440p"
                    android:textColor="@color/console_segmento_texto" />

                <TextView
                    android:id="@+id/consoleSegNativa"
                    style="@style/ConsoleSegmento"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="@dimen/console_espaco_2"
                    android:layout_marginLeft="@dimen/console_espaco_2"
                    android:minWidth="56dp"
                    android:background="@drawable/console_segmento_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingLeft="@dimen/console_espaco_4"
                    android:paddingRight="@dimen/console_espaco_4"
                    android:text="@string/resolution_prefix_native"
                    android:textColor="@color/console_segmento_texto" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/ConsoleDivisor" />

        <!-- Taxa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/console_linha_ajuste"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/console_espaco_4"
            android:paddingRight="@dimen/console_espaco_4">

            <TextView
                style="@style/ConsoleText.Rotulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/console_ajuste_taxa" />

            <TextView
                android:id="@+id/consoleTaxaValorMono"
                style="@style/ConsoleText.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="144 Hz" />

            <LinearLayout
                android:id="@+id/consoleTaxaSegmentos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/consoleSeg60"
                    style="@style/ConsoleSegmento"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="56dp"
                    android:background="@drawable/console_segmento_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingLeft="@dimen/console_espaco_4"
                    android:paddingRight="@dimen/console_espaco_4"
                    android:text="@string/console_taxa_60"
                    android:textColor="@color/console_segmento_texto" />

                <TextView
                    android:id="@+id/consoleSeg90"
                    style="@style/ConsoleSegmento"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="@dimen/console_espaco_2"
                    android:layout_marginLeft="@dimen/console_espaco_2"
                    android:minWidth="56dp"
                    android:background="@drawable/console_segmento_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingLeft="@dimen/console_espaco_4"
                    android:paddingRight="@dimen/console_espaco_4"
                    android:text="@string/console_taxa_90"
                    android:textColor="@color/console_segmento_texto" />

                <TextView
                    android:id="@+id/consoleSeg120"
                    style="@style/ConsoleSegmento"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="@dimen/console_espaco_2"
                    android:layout_marginLeft="@dimen/console_espaco_2"
                    android:minWidth="56dp"
                    android:background="@drawable/console_segmento_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingLeft="@dimen/console_espaco_4"
                    android:paddingRight="@dimen/console_espaco_4"
                    android:text="@string/console_taxa_120"
                    android:textColor="@color/console_segmento_texto" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/ConsoleDivisor" />

        <!-- Taxa de bits -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/console_espaco_4"
            android:paddingRight="@dimen/console_espaco_4"
            android:paddingTop="@dimen/console_espaco_3"
            android:paddingBottom="@dimen/console_espaco_3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/ConsoleText.Rotulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/console_ajuste_taxa_bits" />

                <TextView
                    android:id="@+id/consoleBitrateValor"
                    style="@style/ConsoleText.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="35 Mbps" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/consoleBitrateSlider"
                style="@style/ConsoleSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/console_espaco_2" />
        </LinearLayout>

        <View style="@style/ConsoleDivisor" />

        <!-- Codec -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/console_linha_ajuste"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/console_espaco_4"
            android:paddingRight="@dimen/console_espaco_4">

            <TextView
                style="@style/ConsoleText.Rotulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/console_ajuste_codec" />

            <TextView
                android:id="@+id/consoleCodecValorMono"
                style="@style/ConsoleText.Rotulo2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="Forçar H264" />

            <LinearLayout
                android:id="@+id/consoleCodecSegmentos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/consoleSegCodecAuto"
                    style="@style/ConsoleSegmento"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="56dp"
                    android:background="@drawable/console_segmento_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingLeft="@dimen/console_espaco_4"
                    android:paddingRight="@dimen/console_espaco_4"
                    android:text="@string/console_codec_auto"
                    android:textColor="@color/console_segmento_texto" />

                <TextView
                    android:id="@+id/consoleSegCodecHevc"
                    style="@style/ConsoleSegmento"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="@dimen/console_espaco_2"
                    android:layout_marginLeft="@dimen/console_espaco_2"
                    android:minWidth="56dp"
                    android:background="@drawable/console_segmento_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingLeft="@dimen/console_espaco_4"
                    android:paddingRight="@dimen/console_espaco_4"
                    android:text="@string/console_codec_hevc"
                    android:textColor="@color/console_segmento_texto" />

                <TextView
                    android:id="@+id/consoleSegCodecAv1"
                    style="@style/ConsoleSegmento"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="@dimen/console_espaco_2"
                    android:layout_marginLeft="@dimen/console_espaco_2"
                    android:minWidth="56dp"
                    android:background="@drawable/console_segmento_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingLeft="@dimen/console_espaco_4"
                    android:paddingRight="@dimen/console_espaco_4"
                    android:text="@string/console_codec_av1"
                    android:textColor="@color/console_segmento_texto" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/ConsoleDivisor" />

        <!-- HDR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/console_linha_ajuste"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/console_espaco_4"
            android:paddingRight="@dimen/console_espaco_4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/consoleHdrRotulo"
                    style="@style/ConsoleText.Rotulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/console_ajuste_hdr" />

                <TextView
                    android:id="@+id/consoleHdrLegenda"
                    style="@style/ConsoleText.Legenda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/console_espaco_1"
                    android:text="@string/console_hdr_legenda_indisponivel"
                    android:textAllCaps="false"
                    android:visibility="gone" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/consoleHdrSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View style="@style/ConsoleDivisor" />

        <!-- Áudio -->
        <LinearLayout
            android:id="@+id/consoleAudioLinha"
            android:layout_width="match_parent"
            android:layout_height="@dimen/console_linha_ajuste"
            android:background="@drawable/console_foco"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/console_espaco_4"
            android:paddingRight="@dimen/console_espaco_4">

            <TextView
                style="@style/ConsoleText.Rotulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/console_ajuste_audio" />

            <TextView
                android:id="@+id/consoleAudioValor"
                style="@style/ConsoleText.Rotulo2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Estéreo" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="@dimen/console_espaco_2"
                android:layout_marginLeft="@dimen/console_espaco_2"
                android:importantForAccessibility="no"
                android:rotation="90"
                android:src="@drawable/console_ic_chevron"
                app:tint="@color/console_texto_2" />
        </LinearLayout>

        <View style="@style/ConsoleDivisor" />

        <!-- Modo do toque -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/console_linha_ajuste"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/console_espaco_4"
            android:paddingRight="@dimen/console_espaco_4">

            <TextView
                style="@style/ConsoleText.Rotulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/console_ajuste_modo_toque" />

            <TextView
                android:id="@+id/consoleModoToqueValor"
                style="@style/ConsoleText.Rotulo2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="Mouse normal" />

            <LinearLayout
                android:id="@+id/consoleModoToqueSegmentos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/consoleSegToqueDireto"
                    style="@style/ConsoleSegmento"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="56dp"
                    android:background="@drawable/console_segmento_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingLeft="@dimen/console_espaco_4"
                    android:paddingRight="@dimen/console_espaco_4"
                    android:text="@string/console_modo_toque_direto"
                    android:textColor="@color/console_segmento_texto" />

                <TextView
                    android:id="@+id/consoleSegTouchpad"
                    style="@style/ConsoleSegmento"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="@dimen/console_espaco_2"
                    android:layout_marginLeft="@dimen/console_espaco_2"
                    android:minWidth="56dp"
                    android:background="@drawable/console_segmento_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingLeft="@dimen/console_espaco_4"
                    android:paddingRight="@dimen/console_espaco_4"
                    android:text="@string/console_modo_touchpad"
                    android:textColor="@color/console_segmento_texto" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/ConsoleDivisor" />

        <!-- Barra de texto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/console_linha_ajuste"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/console_espaco_4"
            android:paddingRight="@dimen/console_espaco_4">

            <TextView
                style="@style/ConsoleText.Rotulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/console_guia_barra_texto" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/consoleBarraTextoSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View style="@style/ConsoleDivisor" />

        <!-- Controles na tela -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/console_linha_ajuste"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/console_espaco_4"
            android:paddingRight="@dimen/console_espaco_4">

            <TextView
                style="@style/ConsoleText.Rotulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/console_guia_controles_tela" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/consoleControlesTelaSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <!--
        ================= Avançado =================
        FrameLayout por fora (não LinearLayout): o anel de foco é uma View irmã por
        cima do conteúdo (duplicateParentState + console_foco, convenção de
        console_card_bg.xml) porque android:foreground em ViewGroup comum só existe a
        partir da API 23 e o app tem minSdk 21 — usar background aqui entraria em
        conflito com console_card_bg, que já ocupa o papel de background do cartão.
    -->
    <FrameLayout
        android:id="@+id/consoleAvancadoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/console_espaco_4"
        android:layout_marginBottom="@dimen/console_espaco_5"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/console_card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/console_espaco_4"
            android:paddingRight="@dimen/console_espaco_4"
            android:paddingTop="@dimen/console_espaco_4"
            android:paddingBottom="@dimen/console_espaco_4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/ConsoleText.Rotulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/console_ajuste_avancado_titulo" />

                <TextView
                    android:id="@+id/consoleAvancadoLegenda"
                    style="@style/ConsoleText.Rotulo2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/console_espaco_1"
                    tools:text="@string/console_ajuste_avancado_legenda" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:rotation="90"
                android:src="@drawable/console_ic_chevron"
                app:tint="@color/console_texto_2" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/console_foco"
            android:duplicateParentState="true" />
    </FrameLayout>

</LinearLayout>
