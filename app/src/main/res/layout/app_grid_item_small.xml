<?xml version="1.0" encoding="utf-8"?>
<!--
    O mesmo card do catálogo, na variante compacta. Mudam as medidas; não muda a
    gramática — capa com raio, nome por fora, pílula de estado no canto.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="92dp">

            <ImageView
                android:id="@+id/grid_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/vidro_placeholder"
                android:scaleType="centerCrop" />

            <RelativeLayout
                android:id="@+id/grid_mask"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/grid_overlay"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_centerInParent="true" />
            </RelativeLayout>

            <TextView
                android:id="@+id/grid_pill"
                style="@style/VidroText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentTop="true"
                android:layout_margin="7dp"
                android:background="@drawable/vidro_pill"
                android:fontFamily="@font/manrope_bold"
                android:paddingLeft="7dp"
                android:paddingTop="3dp"
                android:paddingRight="7dp"
                android:paddingBottom="3dp"
                android:textSize="9sp"
                android:visibility="gone"
                tools:text="aberto" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/vidro_poster_frame"
                android:duplicateParentState="true" />

            <ProgressBar
                android:id="@+id/grid_spinner"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_centerInParent="true"
                android:indeterminate="true"
                android:indeterminateTint="@color/vidro_accent_text"
                android:visibility="gone" />
        </RelativeLayout>

        <TextView
            android:id="@+id/grid_text"
            style="@style/VidroText.Item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="13sp"
            tools:text="Steam" />
    </LinearLayout>
</FrameLayout>
