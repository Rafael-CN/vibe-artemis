<?xml version="1.0" encoding="utf-8"?>
<!--
    O catalogo, agora so a casca que hospeda o Compose.

    O que havia aqui - a luz, o cabecalho com voltar/nome/contagem/recarregar, a faixa de
    sessao aberta e a grade - virou com.limelight.ui.compose.TelaCatalogo. Junto foram as
    duas variantes de tablet escritas ontem: a variacao por tamanho deixou de ser pasta de
    recurso e virou condicao sobre a largura real.

    A CELULA da grade continua em XML (app_grid_item.xml), inflada pelo adapter dentro de um
    AndroidView. Ali mora o CachedAppAssetLoader com cache em disco, reamostragem por
    densidade e o VidroPosterBox que trava a proporcao da arte - a peca que atende ao "NUNCA
    deveria quebrar o aspect ratio das imagens". Reescrever isso durante uma migracao de UI
    seria trocar codigo medido contra um host de verdade por codigo novo sem medicao.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vidro_void"
    tools:context=".AppView">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/vidroCatalogoCompose"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
