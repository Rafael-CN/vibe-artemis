<!--
    Apps (celular) — Plano B / F3, B-CONSOLE.md. Hierarquia da referência
    B_Celular_Apps.png / Celular_Apps.dc.html:

        "‹ ● ARTEMIS · on-line" → título "Apps" → grade de 2 colunas.

    vidroBack agora é o próprio cabeçalho clicável (chevron + ponto de estado + nome),
    não só um link "‹ Lugares" — o nome do id não mudou porque AppView#onCreate só
    chama setOnClickListener nele, nunca lê texto seu.

    F6 (devolvida pela verificação): a faixa "N apps publicados · Recarregar" e o
    banner de retomar sessão saíram daqui porque o mockup não tem nenhum dos dois —
    decisão do dono do fork, "esconder pode, apagar não". As duas ações continuam
    alcançáveis: retomar é o selo "Em execução" na própria capa (grid_pill em
    app_grid_item.xml, tocar abre o menu com "Retomar"/"Encerrar e abrir"), e
    recarregar virou item do menu de toque longo da capa (ver AppView#onCreateContextMenu,
    RELOAD_ID) — o gesto de puxar-para-atualizar foi descartado porque a grade
    (app_grid_view.xml) é compartilhada com PcView via AdapterFragment, e um
    SwipeRefreshLayout sem tratamento equivalente lá ficaria girando sem nunca
    completar.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/console_fundo"
    tools:context=".AppView"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/vidroCatalogHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:paddingLeft="@dimen/console_espaco_5"
        android:paddingTop="@dimen/console_espaco_4"
        android:paddingRight="@dimen/console_espaco_5">

        <LinearLayout
            android:id="@+id/vidroBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/console_foco"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/vidro_touch_target"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/console_espaco_2"
            android:paddingRight="@dimen/console_espaco_3">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="@dimen/console_espaco_2"
                android:layout_marginRight="@dimen/console_espaco_2"
                android:importantForAccessibility="no"
                android:rotation="180"
                android:src="@drawable/console_ic_chevron"
                app:tint="@color/console_texto_2" />

            <ImageView
                android:id="@+id/consoleAppsHeaderDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="@dimen/console_espaco_2"
                android:layout_marginRight="@dimen/console_espaco_2"
                android:importantForAccessibility="no"
                android:src="@drawable/vidro_dot_on" />

            <TextView
                android:id="@+id/appListText"
                style="@style/ConsoleText.Rotulo2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="ARTEMIS · on-line" />
        </LinearLayout>

        <TextView
            style="@style/ConsoleText.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/console_espaco_2"
            android:text="@string/console_secao_apps" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/appFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/vidroCatalogHeader"
        android:layout_marginTop="@dimen/console_espaco_3" />

</RelativeLayout>
