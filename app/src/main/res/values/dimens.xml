<resources>

    <!-- Default screen margins, per the Android Design guidelines. -->
    <dimen name="activity_horizontal_margin">16dp</dimen>
    <dimen name="activity_vertical_margin">16dp</dimen>
    <dimen name="tv_channel_logo_width">80dp</dimen>
    <dimen name="tv_channel_logo_height">80dp</dimen>

    <!--
        Identidade Vidro.

        Raios: superfície maior arredonda mais. Não é decoração — é o que separa uma
        folha que chegou de um cartão que sempre esteve ali.
    -->
    <dimen name="vidro_radius_xs">12dp</dimen>
    <dimen name="vidro_radius_s">16dp</dimen>
    <dimen name="vidro_radius_m">20dp</dimen>
    <dimen name="vidro_radius_l">24dp</dimen>
    <dimen name="vidro_radius_xl">28dp</dimen>
    <dimen name="vidro_radius_pill">999dp</dimen>

    <!-- Espaçamento. Passo de 4, com o gesto de 22 que o protótipo usa nas margens. -->
    <dimen name="vidro_space_1">4dp</dimen>
    <dimen name="vidro_space_2">8dp</dimen>
    <dimen name="vidro_space_3">12dp</dimen>
    <dimen name="vidro_space_4">16dp</dimen>
    <dimen name="vidro_space_5">22dp</dimen>
    <dimen name="vidro_space_6">32dp</dimen>

    <!--
        DOIS recuos, não um.

        O protótipo insere bloco de TEXTO a 22 e CARD a 18. A diferença existe porque o
        card já traz a própria borda: alinhar a borda dele com a margem do texto deixaria
        a coluna de leitura torta. Eu tinha achatado os dois em 22 e os cards ficavam
        estreitos demais em relação ao título.
    -->
    <dimen name="vidro_inset_text">22dp</dimen>
    <dimen name="vidro_inset_card">18dp</dimen>

    <!-- Uma borda só, sempre 1px. O peso vem da cor, não da espessura. -->
    <dimen name="vidro_stroke_width">1dp</dimen>

    <!--
        Alcance do polegar: toda ação vive nos 96dp de baixo. O topo recebe aviso,
        e aviso não se toca.
    -->
    <dimen name="vidro_thumb_reach">96dp</dimen>
    <dimen name="vidro_touch_target">48dp</dimen>

    <!-- Largura da folha de ajustes em sessão. -->
    <dimen name="vidro_sheet_width">352dp</dimen>

    <!-- O halo do host. Grande de propósito: é a luz da sala, não um badge. -->
    <dimen name="vidro_halo_size">220dp</dimen>

    <!--
        ================================================================
        Dimensões Console (Plano B — F1). Fonte: docs/planos/B-CONSOLE.md §F1.

        Este arquivo (values/, sem qualificador) é o bucket de CELULAR: o Tab
        S8 Ultra (sw600dp) recebe override em values-sw600dp/dimens.xml só nos
        dois tokens que a F1 diz que diferem por aparelho (linha de ajuste e
        aba da sessão). Os demais valem para os dois.
        ================================================================
    -->

    <!-- Espaçamento — múltiplos de 8, com o 4 de passo mínimo (NOTA.md §2). -->
    <dimen name="console_espaco_1">4dp</dimen>
    <dimen name="console_espaco_2">8dp</dimen>
    <dimen name="console_espaco_3">12dp</dimen>
    <dimen name="console_espaco_4">16dp</dimen>
    <dimen name="console_espaco_5">24dp</dimen>
    <dimen name="console_espaco_6">32dp</dimen>

    <!-- Raios -->
    <dimen name="console_raio_controle">8dp</dimen>
    <dimen name="console_raio_card">12dp</dimen>

    <!-- Linha de ajuste: 56dp no celular (aqui); values-sw600dp sobe para 64dp. -->
    <dimen name="console_linha_ajuste">56dp</dimen>

    <dimen name="console_botao">48dp</dimen>

    <!-- Capa de app, 3:4 -->
    <dimen name="console_capa_w">160dp</dimen>
    <dimen name="console_capa_h">213dp</dimen>

    <!-- Contorno de foco: borda sólida + anel suave por fora dela. -->
    <dimen name="console_foco_borda">3dp</dimen>
    <dimen name="console_foco_anel">4dp</dimen>

    <!-- Aba do menu da sessão: 56x16 no celular (aqui); values-sw600dp sobe para 64x20. -->
    <dimen name="console_aba_w">56dp</dimen>
    <dimen name="console_aba_h">16dp</dimen>

</resources>
