<?xml version="1.0" encoding="utf-8"?>
<!--
    Plano B / F4: no celular a legenda completa do card Avançado ("Codec, taxa de
    atualização e rede — mexa só sabendo por quê") não cabe em uma linha na largura da
    coluna (B_Celular_Ajustes.png mostra só "Mexa só sabendo por quê"); no tablet
    (values-sw600dp/bools.xml) a coluna de 720dp tem espaço de sobra e usa a frase
    inteira (B_Tablet_Ajustes.png).
-->
<resources>
    <bool name="console_avancado_legenda_curta">true</bool>

    <!-- G2, defeito 4: no celular a fileira de teclas especiais da barra de texto
         começa recolhida (atrás de um alternador) para sobrar mais vídeo com o
         teclado virtual aberto — no tablet (values-sw600dp/bools.xml) sobra altura
         de sobra e ela fica sempre visível, como sempre esteve. -->
    <bool name="console_barra_teclas_recolhida_por_padrao">true</bool>
</resources>
