<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Base application theme, dependent on API level. This theme is replaced
        by AppBaseTheme from res/values-vXX/styles.xml on newer devices.

    -->
    <style name="AppBaseTheme" parent="Theme.MaterialComponents.NoActionBar">
        <!--
            Theme customizations available in newer API levels can go in
            res/values-vXX/styles.xml, while customizations related to
            backward-compatibility can go here.
        -->
    </style>

    <!-- Application theme. Identidade Vidro. -->
    <style name="AppTheme" parent="AppBaseTheme">
        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/vidro_void</item>
        <item name="android:navigationBarColor">@color/vidro_void</item>
        <item name="android:colorBackground">@color/vidro_void</item>
        <item name="android:windowBackground">@color/vidro_void</item>
        <item name="android:textColorPrimary">@color/vidro_text</item>
        <item name="android:textColorSecondary">@color/vidro_text_3</item>
        <!--
            O acento aqui é o papel de TEXTO (L 80%), não o de brilho (L 64%). O tom de
            brilho foi medido e reprova em APCA como texto sobre qualquer um dos nossos
            fundos — ele serve para acender, não para escrever.
        -->
        <item name="colorAccent">@color/vidro_accent_text</item>
        <item name="colorPrimary">@color/vidro_accent_text</item>
        <item name="android:colorAccent">@color/vidro_accent_text</item>
        <!--
            Manrope no tema inteiro. Sem isto sobra Roboto em tudo que não recebeu estilo
            explícito — diálogo, preferência, Toast — e a voz da identidade se perde
            justamente nas telas que ninguém redesenha.
        -->
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
    </style>

    <style name="StreamBaseTheme" parent="AppBaseTheme">
        <!-- Transparent streaming background to avoid extra overdraw -->
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Stream activity theme -->
    <style name="StreamTheme" parent="StreamBaseTheme">
        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Added for API 34+ where ImageButton requires these color attrs to inflate -->
        <item name="android:colorControlNormal">@android:color/white</item>
        <item name="android:colorControlHighlight">@android:color/white</item>
        <item name="android:colorAccent">@android:color/white</item>
        <item name="android:colorControlActivated">@android:color/white</item>
        <item name="android:colorButtonNormal">@android:color/white</item>
        <!-- Duplicate non-prefixed color attributes for AppCompat widgets -->
        <item name="colorControlNormal">@android:color/white</item>
        <item name="colorControlHighlight">@android:color/white</item>
        <item name="colorAccent">@android:color/white</item>
        <item name="colorControlActivated">@android:color/white</item>
        <item name="colorButtonNormal">@android:color/white</item>
    </style>

    <style name="SettingsTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="ExternalDisplayControllerTheme" parent="AppTheme">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!--
        ================================================================
        Escala tipográfica Vidro

        Da tabela do handoff, seção 4. Manrope carrega a voz em tudo; JetBrains Mono
        aparece SÓ onde o valor é técnico e precisa de dígito tabular — código de
        pareamento, ms do overlay, endereço IP. Nenhuma fonte de sistema.

        Os pesos apontam direto para o TTF do peso certo em vez de pedir 600 a uma
        família: abaixo da API 28 o Android não resolve peso numérico e sintetiza um
        falso-negrito, que numa geométrica fica visivelmente sujo.
        ================================================================
    -->
    <style name="VidroText">
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="android:textColor">@color/vidro_text</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Título de tela · 29–34 sp · 800 · -0.035em -->
    <style name="VidroText.Display" parent="VidroText">
        <item name="android:fontFamily">@font/manrope_extrabold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.035</item>
        <item name="android:lineSpacingMultiplier">1.06</item>
    </style>

    <!-- Variante curta, para quando o nome do host é longo -->
    <style name="VidroText.Display.Small" parent="VidroText.Display">
        <item name="android:textSize">29sp</item>
    </style>

    <!-- Título de card · 19–21 sp · 700 · -0.03em -->
    <style name="VidroText.Title" parent="VidroText">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <!-- Item de lista · 15–16 sp · 600 · -0.02em -->
    <style name="VidroText.Item" parent="VidroText">
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Corpo / apoio · 13–14 sp · 400–500 · sem tracking -->
    <style name="VidroText.Body" parent="VidroText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/vidro_text_2</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
    </style>

    <!--
        Terciário. L 76%, não 60% — na medição APCA o tom antigo dava Lc 35 sobre o
        fundo da home, abaixo do piso de 60. Subir a luz do texto é a correção; peso
        e tamanho não resolvem contraste.
    -->
    <style name="VidroText.Support" parent="VidroText">
        <item name="android:fontFamily">@font/manrope_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/vidro_text_3</item>
    </style>

    <!-- Rótulo de seção · 12 sp · 700–800 · +0.10em caixa alta -->
    <style name="VidroText.Overline" parent="VidroText">
        <item name="android:fontFamily">@font/manrope_extrabold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/vidro_text_3</item>
    </style>

    <!-- Número técnico · JetBrains Mono · tabular -->
    <style name="VidroText.Numeric" parent="VidroText">
        <item name="android:fontFamily">@font/jetbrains_mono_regular</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/vidro_text_2</item>
    </style>

    <!-- Código de pareamento: quatro dígitos grandes, um por caixa -->
    <style name="VidroText.Code" parent="VidroText">
        <item name="android:fontFamily">@font/jetbrains_mono_bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/vidro_text</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- ================= Componentes ================= -->

    <style name="VidroButton.Accent" parent="VidroText">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:background">@drawable/vidro_button_accent</item>
        <item name="android:textColor">@color/vidro_on_accent</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/vidro_touch_target</item>
        <item name="android:paddingLeft">26dp</item>
        <item name="android:paddingRight">26dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="VidroButton.Ghost" parent="VidroText">
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:background">@drawable/vidro_button_ghost_bg</item>
        <item name="android:textColor">@color/vidro_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/vidro_touch_target</item>
        <item name="android:paddingLeft">22dp</item>
        <item name="android:paddingRight">22dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!--
        Chip de escolha. É o único padrão de seleção do app — o mesmo na folha de
        ajustes e em qualquer lugar que peça "um destes". Alvo de 44dp: abaixo do piso
        de 48 que o handoff declara, mas é a medida do protótipo e são três numa linha
        de 352dp; forçar 48 quebraria a linha.
    -->
    <style name="VidroChip" parent="VidroText">
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/vidro_chip_bg</item>
        <item name="android:textColor">@drawable/vidro_chip_text</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="VidroIconButton">
        <item name="android:background">@drawable/vidro_icon_button_bg</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">12dp</item>
        <item name="android:tint">@color/vidro_text_2</item>
    </style>

    <declare-styleable name="VidroLightView">
        <!-- Estado do host. 0,72 aceso · 0,20 dormindo · 0,07 nenhum host · 0,10 em sessão. -->
        <attr name="vidro_intensity" format="float" />
        <!-- Qualidade da rede: encolhe o alcance e esfria o croma no mesmo gesto. -->
        <attr name="vidro_quality" format="enum">
            <enum name="good" value="0" />
            <enum name="unstable" value="1" />
            <enum name="poor" value="2" />
        </attr>
        <attr name="vidro_core_color" format="color" />
    </declare-styleable>

    <declare-styleable name="ApertureViewGroup">
        <attr name="aperture_color1" format="color" />
        <attr name="aperture_color2" format="color" />
        <attr name="aperture_border_width" format="dimension" />
        <attr name="aperture_border_angle" format="dimension" />
        <attr name="aperture_duration" format="integer" />
        <attr name="aperture_middle_color" format="color" />
    </declare-styleable>

</resources>
