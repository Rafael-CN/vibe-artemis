<!--
    Home no tablet. Mesma hierarquia da versão de celular; o que muda é a MEDIDA.

    O layout de celular esticado para 1722dp virava outro problema: o rodapé com dois
    botões de ~850dp cada, "Seus lugares" e "Adicionar" a mais de um metro de distância um
    do outro, e um vazio no meio que não é respiro, é abandono. Largura de leitura não
    cresce com a tela — o olho tem o alcance que tem.

    Por isso o conteúdo vive numa coluna centrada de 720dp e a luz continua atravessando a
    largura inteira, que é o que faz a tela parecer grande sem ficar oca.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vidro_void"
    tools:context=".PcView">

    <!-- A luz é ambiente: ela pega a largura toda mesmo com o conteúdo centrado. -->
    <com.limelight.ui.VidroLightView
        android:id="@+id/vidroLight"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_alignParentTop="true"
        app:vidro_intensity="0.07"
        app:vidro_quality="good" />

    <LinearLayout
        android:id="@+id/vidroHeader"
        android:layout_width="720dp"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vidro_space_5"
        android:paddingTop="@dimen/vidro_space_6"
        android:paddingRight="@dimen/vidro_space_5">

        <TextView
            android:id="@+id/vidroGreeting"
            style="@style/VidroText.Support"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            tools:text="Boa noite" />

        <!-- Título maior aqui: a 1722dp de largura, 32sp some. -->
        <TextView
            android:id="@+id/vidroStateTitle"
            style="@style/VidroText.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="40sp"
            tools:text="O PC está acordado" />

        <LinearLayout
            android:id="@+id/vidroAnticipation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vidro_space_5"
            android:background="@drawable/vidro_card_accent"
            android:orientation="vertical"
            android:paddingLeft="26dp"
            android:paddingTop="22dp"
            android:paddingRight="26dp"
            android:paddingBottom="18dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/VidroText.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vidro_likely_now"
                android:textColor="@color/vidro_accent_text" />

            <TextView
                android:id="@+id/vidroAnticipationTitle"
                style="@style/VidroText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="26sp"
                tools:text="Retomar Desktop" />

            <TextView
                android:id="@+id/vidroAnticipationWhy"
                style="@style/VidroText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Você faz isso quase toda noite por volta desta hora." />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vidro_space_3"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/vidroNotNow"
                    style="@style/VidroText.Support"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/vidro_touch_target"
                    android:paddingEnd="@dimen/vidro_space_5"
                    android:paddingRight="@dimen/vidro_space_5"
                    android:text="@string/vidro_not_now" />

                <TextView
                    android:id="@+id/vidroNotToday"
                    style="@style/VidroText.Support"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/vidro_touch_target"
                    android:text="@string/vidro_not_today" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/vidroContinueSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/VidroText.Item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vidro_space_5"
                android:layout_marginBottom="@dimen/vidro_space_2"
                android:text="@string/vidro_continue"
                android:textColor="@color/vidro_text_2" />

            <LinearLayout
                android:id="@+id/vidroContinueList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vidro_space_6"
            android:layout_marginBottom="@dimen/vidro_space_2">

            <TextView
                style="@style/VidroText.Item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:text="@string/vidro_your_places"
                android:textColor="@color/vidro_text_2"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/vidroAddPlace"
                style="@style/VidroText.Support"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackground"
                android:text="@string/vidro_add"
                android:textColor="@color/vidro_accent_text"
                android:textSize="15sp" />
        </RelativeLayout>
    </LinearLayout>

    <!--
        Rodapé de largura natural, encostado à direita da coluna. Dois botões esticados
        por 1722dp não são um par, são duas faixas.
    -->
    <LinearLayout
        android:id="@+id/vidroFooter"
        android:layout_width="720dp"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vidro_space_5"
        android:paddingTop="@dimen/vidro_space_3"
        android:paddingRight="@dimen/vidro_space_5"
        android:paddingBottom="@dimen/vidro_space_6">

        <TextView
            android:id="@+id/profilesButton"
            style="@style/VidroButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:layout_marginRight="10dp"
            android:contentDescription="@string/profile_manager_choose_profile"
            android:gravity="center"
            android:minWidth="180dp"
            android:text="@string/vidro_scenes" />

        <TextView
            android:id="@+id/settingsButton"
            style="@style/VidroButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:gravity="center"
            android:minWidth="180dp"
            android:text="@string/vidro_settings" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="720dp"
        android:layout_height="match_parent"
        android:layout_above="@id/vidroFooter"
        android:layout_below="@id/vidroHeader"
        android:layout_centerHorizontal="true">

        <LinearLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/vidro_space_6"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/pcs_loading"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/vidro_accent_text" />

            <TextView
                style="@style/VidroText.Support"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vidro_space_4"
                android:gravity="center"
                android:text="@string/searching_pc" />
        </LinearLayout>

    </RelativeLayout>

    <include layout="@layout/vidro_pairing" />

</RelativeLayout>
