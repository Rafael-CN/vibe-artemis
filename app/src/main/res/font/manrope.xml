<?xml version="1.0" encoding="utf-8"?>
<!--
    Manrope, empacotada. Instâncias estáticas geradas a partir da fonte variável do
    Google Fonts: `fontVariationSettings` só existe da API 26 para cima e o minSdk aqui
    é 21, então depender do eixo variável deixaria metade do range renderizando um peso
    só. Os TTF estão em res/font/ e a licença OFL em assets/fonts/.

    Os atributos aparecem duplicados com e sem o prefixo `app:` de propósito — é assim
    que o backport do AppCompat lê a família abaixo da API 26.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/manrope_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/manrope_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/manrope_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/manrope_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

    <font
        android:font="@font/manrope_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/manrope_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />

    <font
        android:font="@font/manrope_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/manrope_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

    <font
        android:font="@font/manrope_extrabold"
        android:fontStyle="normal"
        android:fontWeight="800"
        app:font="@font/manrope_extrabold"
        app:fontStyle="normal"
        app:fontWeight="800" />

</font-family>
