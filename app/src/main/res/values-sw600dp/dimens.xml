<?xml version="1.0" encoding="utf-8"?>
<!--
    Overrides de tablet para as dimensões Console (Plano B — F1). Só os dois
    tokens que docs/planos/B-CONSOLE.md §F1 marca como diferentes por aparelho;
    os demais valem dos dois lados e ficam só em values/dimens.xml.
-->
<resources>

    <!-- Linha de ajuste: 64dp no tablet (o celular, em values/, é 56dp). -->
    <dimen name="console_linha_ajuste">64dp</dimen>

    <!-- Aba do menu da sessão: 64x20 no tablet (o celular, em values/, é 56x16). -->
    <dimen name="console_aba_w">64dp</dimen>
    <dimen name="console_aba_h">20dp</dimen>

</resources>
