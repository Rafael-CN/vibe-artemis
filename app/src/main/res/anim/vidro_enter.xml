<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela entrando. O handoff descreve "a capa tocada cresce para a tela cheia": o que
    chega vem de perto do tamanho final e sobe até ele, com alpha junto.

    Sem translação horizontal. O slide lateral padrão do Android conta uma história de
    páginas lado a lado; esta identidade conta uma de profundidade — o que você tocou
    virou a tela inteira.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/vidro_enter"
    android:shareInterpolator="true">

    <alpha
        android:duration="@integer/vidro_motion_enter"
        android:fromAlpha="0.0"
        android:toAlpha="1.0" />

    <scale
        android:duration="@integer/vidro_motion_enter"
        android:fromXScale="0.94"
        android:fromYScale="0.94"
        android:pivotX="50%p"
        android:pivotY="50%p"
        android:toXScale="1.0"
        android:toYScale="1.0" />

</set>
