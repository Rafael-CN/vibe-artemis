<?xml version="1.0" encoding="utf-8"?>
<!--
    Card "Adicionar PC" tracejado (Celular_Computadores.dc.html). android:dashWidth
    exige a view em LAYER_TYPE_SOFTWARE — a aceleração de hardware não desenha
    dashPathEffect corretamente; quem usa este drawable chama
    view.setLayerType(View.LAYER_TYPE_SOFTWARE, null) no código (ConsoleUi helper).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1.5dp"
        android:color="@color/console_borda"
        android:dashWidth="6dp"
        android:dashGap="4dp" />
    <corners android:radius="@dimen/console_raio_card" />
</shape>
