<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Corrigido pelo verificador da F1: os dois hex abaixo eram o azul antigo do Vidro
        (#1E8FEE) cravado direto, sem passar por nenhum alias `vidro_*` — o card de cena
        "ativado" saía azul em vez de menta. Mesmos alphas (0x1F e 0x8C), matiz trocado
        para console_acento (#7FE0C7).
    -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F7FE0C7" />
            <stroke android:width="@dimen/vidro_stroke_width" android:color="#8C7FE0C7" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/console_superficie_selecionada" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0DFFFFFF" />
            <stroke android:width="@dimen/vidro_stroke_width" android:color="#1AFFFFFF" />
            <corners android:radius="23dp" />
        </shape>
    </item>
</selector>
