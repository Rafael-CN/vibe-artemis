<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F1E8FEE" />
            <stroke android:width="@dimen/vidro_stroke_width" android:color="#8C1E8FEE" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vidro_surface_overlay_alt" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0DFFFFFF" />
            <stroke android:width="@dimen/vidro_stroke_width" android:color="#1AFFFFFF" />
            <corners android:radius="23dp" />
        </shape>
    </item>
</selector>
