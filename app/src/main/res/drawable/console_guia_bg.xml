<?xml version="1.0" encoding="utf-8"?>
<!--
    Fundo da barra da guia: console_superficie_elevada sólido, com uma borda fina
    só embaixo — é o que separa a guia do vídeo por trás dela sem precisar de véu
    (a restrição do SurfaceView já garante isso, mas a borda ainda ajuda a leitura).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/console_superficie_elevada" />
        </shape>
    </item>
    <item android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="@dimen/vidro_stroke_width"
                android:color="@color/console_borda" />
        </shape>
    </item>
</layer-list>
