<?xml version="1.0" encoding="utf-8"?>
<!--
    Dormindo: a mesma luz, quase apagada. Nada muda de cor, só de intensidade.

    Corrigido pelo verificador da F1: centerColor/endColor eram hex cravado do azul
    antigo do Vidro (#1E8FEE) — só o startColor resolvia pelo alias `vidro_halo_asleep`
    (agora console_texto_2). O halo saía cinza no centro e azul na borda. Mesmos alphas
    (0x14 e 0x00), matiz trocado para console_acento (#7FE0C7), coerente com
    vidro_halo_awake.xml logo abaixo dele.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="50%p"
        android:startColor="@color/vidro_halo_asleep"
        android:centerColor="#147FE0C7"
        android:endColor="#007FE0C7" />
</shape>
