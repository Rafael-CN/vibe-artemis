<?xml version="1.0" encoding="utf-8"?>
<!--
    Campo de entrada da barra de composição. Mesma gramática do vidro_field — fundo baixo e
    borda de 1px —, só que com preenchimento OPACO: este é o único campo do app que fica
    por cima do vídeo, e o realce translúcido do outro deixava a imagem atravessar
    justamente a área em que o texto é escrito.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/vidro_field_fill_session" />
    <stroke android:width="@dimen/vidro_stroke_width" android:color="@color/vidro_stroke_glass" />
    <corners android:radius="@dimen/vidro_radius_s" />
</shape>
