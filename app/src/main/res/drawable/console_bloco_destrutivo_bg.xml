<?xml version="1.0" encoding="utf-8"?>
<!--
    Fundo do bloco "Encerrar no PC": destrutivo a 12% sempre visível, porque é a
    única ação irreversível da guia e não deve se camuflar com o resto (NOTA.md §2).
    O contorno de foco de verdade vem de android:foreground=@drawable/console_foco
    no bloco, aplicado por cima deste fundo.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/console_destrutivo_fundo" />
    <corners android:radius="@dimen/console_raio_controle" />
</shape>
