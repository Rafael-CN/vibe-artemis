<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vidro_surface_overlay_alt" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vidro_surface_overlay" />
            <stroke android:width="@dimen/vidro_stroke_width" android:color="@color/vidro_stroke_hairline" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</selector>
