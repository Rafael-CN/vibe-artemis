<?xml version="1.0" encoding="utf-8"?>
<!-- Botão flutuante em sessão: mesmo vidro fosco do resto, borda de 1px. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/console_superficie_selecionada">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/console_acento" />
            <stroke android:color="@color/console_acento" android:width="@dimen/vidro_stroke_width" />
            <size android:width="36dp" android:height="36dp" />
        </shape>
    </item>
</ripple>
