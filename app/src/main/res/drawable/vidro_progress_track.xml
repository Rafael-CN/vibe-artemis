<?xml version="1.0" encoding="utf-8"?>
<!--
    Barra de progresso da conexão. Fina de propósito: ela informa que está vivo, não
    convida a olhar. Nada de spinner — a barra e a luz já dizem isso.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#24FFFFFF" />
            <corners android:radius="@dimen/vidro_radius_pill" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/vidro_accent_fill" />
                <corners android:radius="@dimen/vidro_radius_pill" />
            </shape>
        </clip>
    </item>
</layer-list>
