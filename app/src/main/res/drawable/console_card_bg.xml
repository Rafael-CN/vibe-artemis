<?xml version="1.0" encoding="utf-8"?>
<!--
    Card em repouso da Console: console_superficie, borda de 1px, raio de card. Base
    estática por trás do conteúdo; o contorno de FOCO vem por cima, como uma última
    View com android:duplicateParentState + @drawable/console_foco — mesma convenção
    já usada em pc_grid_item/app_grid_item (grid_frame sobre grid_image).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/console_superficie" />
    <stroke android:width="@dimen/vidro_stroke_width" android:color="@color/console_borda" />
    <corners android:radius="@dimen/console_raio_card" />
</shape>
